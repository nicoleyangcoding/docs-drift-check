{
  "name": "docs-drift-check",
  "version": "1.1.0",
  "private": true,
  "description": "GitHub Action that comments on pull requests that change code without updating the docs that describe it.",
  "type": "module",
  "license": "MIT",
  "author": "Nicole Yang",
  "repository": "github:nicoleyangcoding/docs-drift-check",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "all": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "minimatch": "^11.0.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
